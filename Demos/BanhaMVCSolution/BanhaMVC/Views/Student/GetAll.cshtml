@model StudentIndexViewModel

@{
    ViewData["Title"] = "All Students";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>All Students</h2>
    <a href="/Student/Add" class="btn btn-success">
        + Add New Student
    </a>
</div>

<!-- Search and Filter Bar -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" action="/Student/GetAll" class="row g-3 align-items-end">
            <!-- Search by Name -->
            <div class="col-md-5">
                <label class="form-label fw-bold">Search by Name</label>
                <input type="text" 
                       name="search" 
                       value="@Model.Search" 
                       class="form-control" 
                       placeholder="Enter student name..." />
            </div>

            <!-- Filter based on Department -->
            <div class="col-md-4">
                <label class="form-label fw-bold">Filter by Department</label>
                <select name="deptId" class="form-select">
                    <option value="">-- All Departments --</option>
                    @foreach (var dept in Model.DeptList)
                    {
                        if (dept.Id == Model.SelectedDeptId)
                        {
                            <option value="@dept.Id" selected>@dept.Name</option>
                        }
                        else
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    }
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a href="/Student/GetAll" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Students Data Table -->
@if (Model.Students.Any())
{
    <table class="table table-hover table-bordered align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th style="width: 80px;">No.</th>
                <th>Name</th>
                <th>Age</th>
                <th>Address</th>
                <th>Department</th>
                <th style="width: 220px;" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
            {
                <tr>
                    <td>@student.Id</td>
                    <td class="fw-semibold">@student.Name</td>
                    <td>@student.Age</td>
                    <td>@(student.Address ?? "—")</td>
                    <td>
                        <span class="badge bg-info text-dark">
                            @(student.Department?.Name ?? "No Department")
                        </span>
                    </td>
                    <td class="text-center">
                        <a href="/Student/GetById/@student.Id" class="btn btn-sm btn-outline-info">Details</a>
                        <a href="/Student/Edit/@student.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        <a href="/Student/Delete/@student.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">
            Showing Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (Total: @Model.TotalCount students)
        </span>

        <nav aria-label="Page navigation">
            <ul class="pagination mb-0">
                <!-- Previous Button -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" 
                       href="/Student/GetAll?search=@Model.Search&deptId=@Model.SelectedDeptId&page=@(Model.CurrentPage - 1)">
                        Previous
                    </a>
                </li>

                <!-- Page Numbers -->
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" 
                           href="/Student/GetAll?search=@Model.Search&deptId=@Model.SelectedDeptId&page=@p">
                            @p
                        </a>
                    </li>
                }

                <!-- Next Button -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" 
                       href="/Student/GetAll?search=@Model.Search&deptId=@Model.SelectedDeptId&page=@(Model.CurrentPage + 1)">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
else
{
    <div class="alert alert-warning text-center my-4" role="alert">
        <h5>No students found matching your search / filter criteria!</h5>
        <p class="mb-0">Try clearing the search term or selecting another department.</p>
        <a href="/Student/GetAll" class="btn btn-sm btn-outline-dark mt-2">Clear Filters</a>
    </div>
}
