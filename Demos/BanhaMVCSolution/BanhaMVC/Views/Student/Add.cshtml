@model StudentWithDeptListViewModel

@{
    ViewData["Title"] = "Add New Student";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0" style="max-width: 650px; margin: auto;">
        <div class="card-header bg-success text-white py-3">
            <h4 class="mb-0">Add New Student</h4>
        </div>
        <div class="card-body p-4">
            <form method="post" action="/Student/SaveAdd">
                <!-- Name -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Student Name <span class="text-danger">*</span></label>
                    <input type="text" 
                           id="Name" 
                           name="Name" 
                           value="@Model.Name" 
                           class="form-control" 
                           placeholder="Enter full name" 
                           required />
                </div>

                <!-- Age -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Age <span class="text-danger">*</span></label>
                    <input type="number" 
                           id="Age" 
                           name="Age" 
                           value="@(Model.Age > 0 ? Model.Age : "")" 
                           class="form-control" 
                           placeholder="Enter age (e.g. 21)" 
                           required />
                </div>

                <!-- Address -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Address / City</label>
                    <input type="text" 
                           id="Address" 
                           name="Address" 
                           value="@Model.Address" 
                           class="form-control" 
                           placeholder="Enter address" />
                </div>

                <!-- Department Dropdown (Show all Departments) -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Department <span class="text-danger">*</span></label>
                    <select id="DeptId" name="DeptId" class="form-select" required>
                        <option value="">-- Select Department --</option>
                        @foreach (var dept in Model.DeptList)
                        {
                            if (dept.Id == Model.DeptId)
                            {
                                <option value="@dept.Id" selected>@dept.Name</option>
                            }
                            else
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        }
                    </select>
                    <div class="form-text">Choose the department the student belongs to.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">Save Student</button>
                    <a href="/Student/GetAll" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
