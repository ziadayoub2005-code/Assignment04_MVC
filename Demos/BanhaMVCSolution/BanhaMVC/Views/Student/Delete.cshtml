@model Student

@{
    ViewData["Title"] = "Warning - Delete Student";
}

<div class="container mt-4">
    <div class="card border-danger shadow-sm" style="max-width: 650px; margin: auto;">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0">⚠️ Warning: Delete Confirmation</h4>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning mb-4" role="alert">
                <strong>Attention!</strong> Are you sure you want to delete this student record? This action cannot be undone.
            </div>

            <h5 class="text-secondary mb-3">Student Record Details:</h5>
            <ul class="list-group list-group-flush mb-4 border rounded">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted fw-bold">Student ID:</span>
                    <span>@Model.Id</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted fw-bold">Full Name:</span>
                    <span class="fw-bold fs-5 text-danger">@Model.Name</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted fw-bold">Age:</span>
                    <span>@Model.Age years</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted fw-bold">Department:</span>
                    <span>@(Model.Department?.Name ?? "No Department Assigned")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted fw-bold">Address:</span>
                    <span>@(Model.Address ?? "—")</span>
                </li>
            </ul>

            <!-- Confirm Delete Form -->
            <form method="post" action="/Student/ConfirmDelete/@Model.Id" class="d-flex gap-2">
                <input type="submit" value="Yes, Confirm Delete" class="btn btn-danger px-4" />
                <a href="/Student/GetAll" class="btn btn-outline-secondary">Cancel & Back to List</a>
            </form>
        </div>
    </div>
</div>
