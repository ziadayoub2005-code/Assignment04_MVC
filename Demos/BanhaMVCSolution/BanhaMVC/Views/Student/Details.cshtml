@model Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0" style="max-width: 650px; margin: auto;">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">Student Profile & Details</h4>
        </div>
        <div class="card-body p-4">
            <div class="row mb-3 pb-2 border-bottom">
                <div class="col-sm-4 text-muted fw-bold">Student ID:</div>
                <div class="col-sm-8 fw-semibold">@Model.Id</div>
            </div>

            <div class="row mb-3 pb-2 border-bottom">
                <div class="col-sm-4 text-muted fw-bold">Full Name:</div>
                <div class="col-sm-8 fs-5 text-dark fw-bold">@Model.Name</div>
            </div>

            <div class="row mb-3 pb-2 border-bottom">
                <div class="col-sm-4 text-muted fw-bold">Age:</div>
                <div class="col-sm-8">@Model.Age years old</div>
            </div>

            <div class="row mb-3 pb-2 border-bottom">
                <div class="col-sm-4 text-muted fw-bold">Address / City:</div>
                <div class="col-sm-8">@(Model.Address ?? "Not specified")</div>
            </div>

            <div class="row mb-3 pb-2 border-bottom">
                <div class="col-sm-4 text-muted fw-bold">Department:</div>
                <div class="col-sm-8">
                    <span class="badge bg-info text-dark fs-6">
                        @(Model.Department?.Name ?? "No Department Assigned")
                    </span>
                </div>
            </div>

            @if (Model.Department != null && !string.IsNullOrEmpty(Model.Department.Mgrname))
            {
                <div class="row mb-3 pb-2 border-bottom">
                    <div class="col-sm-4 text-muted fw-bold">Department Manager:</div>
                    <div class="col-sm-8 text-secondary">@Model.Department.Mgrname</div>
                </div>
            }

            <div class="d-flex gap-2 mt-4">
                <a href="/Student/Edit/@Model.Id" class="btn btn-warning">Edit Student</a>
                <a href="/Student/Delete/@Model.Id" class="btn btn-outline-danger">Delete</a>
                <a href="/Student/GetAll" class="btn btn-secondary ms-auto">Back to List</a>
            </div>
        </div>
    </div>
</div>
