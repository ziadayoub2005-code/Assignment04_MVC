<!-- strong type View > emp -->
@model EmpWithDeptListViewModel

<h2>Edit</h2>

<form method="Post" action="/Emp/SaveEdit/@Model.Id">
	<div>
		<label>Name</label>
		<input type="text" id="Name" name="Name" value="@Model.Name" class="form-control" />
	</div>
	<div>
		<label>Address</label>
		<input type="text" id="Address" name="Address" value="@Model.Address" class="form-control" />
	</div>
	<div>
		<label>Age</label>
		<input type="number" id="Age" name="Age" value="@Model.Age" class="form-control" />
	</div>
	<div>
		<label>Title</label>
		<input type="text" id="Title" name="Title" value="@Model.Title" class="form-control" />
	</div>
	<div>
		<label>Dept</label>
		@* <input type="number" id="DeptId" name="DeptId" value="@Model.DeptId" class="form-control" /> *@
		<select id="DeptId" name="DeptId" class="form-control">
			@foreach (var item in Model.DeptList)
			{
				if (item.Id == Model.DeptId)
				{
					<option value="@item.Id" selected>@item.Name</option>
				}
				else
				{
					<option value="@item.Id">@item.Name</option>
				}

			}
		</select>
	</div>
	<input type="submit" value="Save" class="btn btn-success mt-3" />
</form>