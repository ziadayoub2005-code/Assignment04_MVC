@model List<Employee>

<h2>All Employees</h2>

<table class="table table-hover table-bordered">
	<tr>
		<th>Id</th>
		<th>Name</th>
		<th>Salary</th>
		<th></th>
		<th></th>
	</tr>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.Id</td>
			<td>@item.Name</td>
			<td>@item.Age</td>
			<td><a href="/Emp/Edit/@item.Id">Edit</a></td>
			<td><a href="/Emp/delete/@item.Id">delete</a></td>
		</tr>
	}
</table>